# PostgreSQL connection string used by the app at runtime.
# For Supabase, keep sslmode=require in the URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app_db?sslmode=disable

# Optional: separate URL for migrations (can be the same as DATABASE_URL).
# For Supabase, use a direct/session pooler URL and keep sslmode=require.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app_db?sslmode=disable

# Required in production before the first request.
INITIAL_ADMIN_NAME=Hotel Administrator
INITIAL_ADMIN_EMAIL=admin@yourhotel.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Required for session signing.
SESSION_SECRET=replace-with-a-long-random-secret
